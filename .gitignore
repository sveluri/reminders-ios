# .gitignore for iOS/Swift projects

# Xcode
build/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.xcworkspace
!default.xcworkspace/
*.playground
xcuserdata/
*.xccheckout
*.moved-aside
DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
*.swiftpm
**/xcshareddata/WorkspaceSettings.xcsettings

# Swift Package Manager
.build/
.swiftpm/
*.xcodeproj/

# CocoaPods
Pods/
Podfile.lock

# Carthage
Carthage/Build
*.resolved

# Environment
.env
.env.local

# OS
.DS_Store
.AppleDouble
.LSOverride

# IDE
.idea/
*.swp
*.swo
*~

# Dependencies
node_modules/
npm-debug.log

# Generated files
*.generated.swift

# Temporary files
*.tmp
*.temp
